# 数据库（Supabase Postgres）
# Pooling URL（用于运行时，Serverless 必须用连接池）
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct URL（用于迁移，绕过连接池）
DIRECT_URL="postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres?schema=public"

# NextAuth
NEXTAUTH_SECRET="用 `openssl rand -base64 32` 生成"
NEXTAUTH_URL="http://localhost:3000"

# DeepSeek AI
DEEPSEEK_API_KEY="sk-xxxxxxxx"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Cron 定时任务密钥
CRON_SECRET="用 `openssl rand -base64 32` 生成"

# 应用 URL（用于 CSRF 校验、邮件链接等）
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sentry（可选，错误监控）
SENTRY_DSN=""

# Resend（邮件发送，用于忘记密码）
RESEND_API_KEY="re_xxxxxxxx"

# Umami 埋点（可选，隐私友好无 cookie）
# 自建 Umami 或用云服务，填入 script src 与 website id
NEXT_PUBLIC_UMAMI_SRC="https://umami.example.com/script.js"
NEXT_PUBLIC_UMAMI_WEBSITE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ICP 备案号（个人主体备案后填入，显示在 footer）
NEXT_PUBLIC_ICP_NUMBER="沪ICP备XXXXXXXX号-1"

# 客服邮箱（显示在 footer 的"联系我们"）
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"
